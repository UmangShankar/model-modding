{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelmodding.org/schemas/abom.schema.json",
  "title": "Agent Behaviour Bill of Materials",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "algorithm", "builder", "source_digest", "build_digest", "recipe", "components", "artifacts", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "document_type": {"const": "agent-behaviour-bill-of-materials"},
    "algorithm": {"const": "sha256"},
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "model-modding"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}
      }
    },
    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "build_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recipe": {"type": "object"},
    "components": {"type": "array", "minItems": 1},
    "artifacts": {
      "type": "object",
      "required": ["system_prompt"],
      "properties": {
        "system_prompt": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "system.md"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
