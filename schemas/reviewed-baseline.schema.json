{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelmodding.org/schemas/reviewed-baseline.schema.json",
  "title": "Model Modding Reviewed Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "baseline_digest", "scope", "reviewer", "notes", "evidence_digest", "recipe", "evaluator", "fixture_set_digest", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "document_type": {"const": "model-modding-reviewed-baseline"},
    "baseline_digest": {"$ref": "#/$defs/digest"},
    "scope": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "notes": {"type": "string"},
    "evidence_digest": {"$ref": "#/$defs/digest"},
    "recipe": {"type": "object", "required": ["name", "version", "source_digest", "build_digest"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "source_digest": {"$ref": "#/$defs/digest"}, "build_digest": {"$ref": "#/$defs/digest"}}, "additionalProperties": true},
    "evaluator": {"type": ["object", "null"]},
    "fixture_set_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
