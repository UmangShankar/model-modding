{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelmodding.org/schemas/repeated-evidence.schema.json",
  "title": "Model Modding Repeated Evidence Aggregate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "release_engine", "aggregate_digest", "recipe", "evaluator", "fixture_set_digest", "evidence_count", "target_count", "minimum_repetitions", "require_zero_critical", "pipeline", "targets", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "document_type": {"const": "model-modding-repeated-evidence-aggregate"},
    "release_engine": {"$ref": "#/$defs/engine"},
    "aggregate_digest": {"$ref": "#/$defs/digest"},
    "recipe": {"type": "object", "required": ["name", "version", "source_digest", "build_digest"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "source_digest": {"$ref": "#/$defs/digest"}, "build_digest": {"$ref": "#/$defs/digest"}}, "additionalProperties": true},
    "evaluator": {"type": ["object", "null"]},
    "fixture_set_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "evidence_count": {"type": "integer", "minimum": 1},
    "target_count": {"type": "integer", "minimum": 1},
    "minimum_repetitions": {"type": "integer", "minimum": 1},
    "require_zero_critical": {"type": "boolean"},
    "pipeline": {"type": "object", "additionalProperties": false, "required": ["status", "repetition_failures", "critical_failure_targets"], "properties": {"status": {"enum": ["passed", "failed"]}, "repetition_failures": {"type": "array", "items": {"type": "string"}}, "critical_failure_targets": {"type": "array", "items": {"type": "string"}}}},
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "engine": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "model-modding"}, "version": {"type": "string", "minLength": 1}}},
    "severityCounts": {"type": "object", "additionalProperties": false, "required": ["critical", "major", "minor"], "properties": {"critical": {"type": "integer", "minimum": 0}, "major": {"type": "integer", "minimum": 0}, "minor": {"type": "integer", "minimum": 0}}},
    "invariant": {"type": "object", "additionalProperties": false, "required": ["kind", "invariant", "severity", "tested", "passed", "failed", "pass_rate", "status"], "properties": {"kind": {"type": "string", "minLength": 1}, "invariant": {"type": "string", "minLength": 1}, "severity": {"enum": ["critical", "major", "minor"]}, "tested": {"type": "integer", "minimum": 0}, "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "pass_rate": {"type": "number", "minimum": 0, "maximum": 1}, "status": {"enum": ["passed", "failed"]}}},
    "run": {"type": "object", "additionalProperties": false, "required": ["evidence_digest", "created_at", "source_control", "runtime", "cases", "passed", "modded_failures", "invariant_observations"], "properties": {"evidence_digest": {"$ref": "#/$defs/digest"}, "created_at": {"type": "string", "format": "date-time"}, "source_control": {"type": "object"}, "runtime": {"type": "object"}, "cases": {"type": "integer", "minimum": 0}, "passed": {"type": "boolean"}, "modded_failures": {"$ref": "#/$defs/severityCounts"}, "invariant_observations": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["tested", "passed", "failed"], "properties": {"tested": {"type": "integer", "minimum": 0}, "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}}}}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["key", "provider", "model", "repetitions", "minimum_cases", "runs_passed", "runs_failed", "critical_free_runs", "modded_failures", "evidence_digests", "invariants", "runs"], "properties": {"key": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "repetitions": {"type": "integer", "minimum": 1}, "minimum_cases": {"type": "integer", "minimum": 0}, "runs_passed": {"type": "integer", "minimum": 0}, "runs_failed": {"type": "integer", "minimum": 0}, "critical_free_runs": {"type": "integer", "minimum": 0}, "modded_failures": {"$ref": "#/$defs/severityCounts"}, "evidence_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}}, "invariants": {"type": "array", "items": {"$ref": "#/$defs/invariant"}}, "runs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/run"}}}}
  }
}
