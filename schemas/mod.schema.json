{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-modding.org/schemas/mod.schema.json",
  "title": "Model Modding Manifest",
  "description": "Schema for a reusable Model Modding mod manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "status",
    "description",
    "category",
    "authors",
    "license"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": ["draft", "experimental", "community-validated", "stable", "archived"]
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "category": {
      "enum": ["personality", "domain", "workflow", "tool", "memory", "safety", "interface", "experimental"]
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "github": { "type": "string", "minLength": 1 }
        }
      }
    },
    "compatible_models": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "default": []
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "suites": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    }
  }
}
