{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelmodding.org/schemas/release-readiness.schema.json",
  "title": "Model Modding v0.2 Release Readiness",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "release_engine", "readiness_digest", "status", "minimum_repetitions", "minimum_cases", "required_providers", "aggregate_digest", "matrix_digest", "recipe", "checks", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "document_type": {"const": "model-modding-v0.2-release-readiness"},
    "release_engine": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "model-modding"}, "version": {"type": "string", "minLength": 1}}},
    "readiness_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["ready", "not_ready"]},
    "minimum_repetitions": {"type": "integer", "minimum": 1},
    "minimum_cases": {"type": "integer", "minimum": 1},
    "required_providers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "aggregate_digest": {"$ref": "#/$defs/digest"},
    "matrix_digest": {"$ref": "#/$defs/digest"},
    "recipe": {"type": "object", "required": ["name", "version", "source_digest", "build_digest"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "source_digest": {"$ref": "#/$defs/digest"}, "build_digest": {"$ref": "#/$defs/digest"}}, "additionalProperties": true},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "passed", "detail"], "properties": {"name": {"type": "string", "minLength": 1}, "passed": {"type": "boolean"}, "detail": {"type": "string", "minLength": 1}}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
