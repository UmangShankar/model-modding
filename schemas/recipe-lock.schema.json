{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelmodding.org/schemas/recipe-lock.schema.json",
  "title": "Model Modding Recipe Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "algorithm", "source_digest", "digest_inputs", "build_digest", "recipe", "components", "outputs"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "algorithm": {"const": "sha256"},
    "source_digest": {"$ref": "#/$defs/digest"},
    "digest_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_schema_version", "lock_schema_version", "abom_schema_version", "source_digest", "system_prompt_sha256"],
      "properties": {
        "build_schema_version": {"const": "0.1"},
        "lock_schema_version": {"const": "0.1"},
        "abom_schema_version": {"const": "0.1"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "system_prompt_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "build_digest": {"$ref": "#/$defs/digest"},
    "recipe": {"$ref": "#/$defs/recipe"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_prompt"],
      "properties": {
        "system_prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "system.md"},
            "sha256": {"$ref": "#/$defs/digest"}
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^[^\\\\]+$"},
        "sha256": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "severity"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "severity": {"enum": ["critical", "major", "minor"]}
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve", "prohibit"],
      "properties": {
        "preserve": {"type": "array", "items": {"$ref": "#/$defs/invariant"}},
        "prohibit": {"type": "array", "items": {"$ref": "#/$defs/invariant"}}
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description", "license", "configuration", "manifest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "configuration": {"type": "object"},
        "manifest": {"$ref": "#/$defs/file"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "reference", "name", "version", "role", "status", "license", "manifest", "instructions", "capabilities", "dependencies", "conflicts", "compatible_models", "invariants", "component_digest"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "reference": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "role": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]},
        "manifest": {"$ref": "#/$defs/file"},
        "instructions": {"type": "array", "items": {"$ref": "#/$defs/file"}},
        "capabilities": {"type": "array"},
        "dependencies": {"type": "array"},
        "conflicts": {"type": "array"},
        "compatible_models": {"type": "array"},
        "invariants": {"$ref": "#/$defs/invariants"},
        "component_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
