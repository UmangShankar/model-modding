{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelmodding.org/schemas/evidence-bundle.schema.json",
  "title": "Model Modding Run Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "evidence_engine", "evidence_digest", "bundle_type", "created_at", "recipe", "runtime", "source_control", "privacy", "response_count", "artifacts", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "document_type": {"const": "model-modding-run-evidence"},
    "evidence_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "model-modding"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "evidence_digest": {"$ref": "#/$defs/digest"},
    "bundle_type": {"enum": ["run", "evaluation", "benchmark"]},
    "created_at": {"type": "string", "format": "date-time"},
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_digest", "build_digest", "abom_sha256", "lock_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"},
        "build_digest": {"$ref": "#/$defs/digest"},
        "abom_sha256": {"$ref": "#/$defs/digest"},
        "lock_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider", "requested_models", "requested_options"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "requested_models": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "requested_options": {"type": "object"}
      }
    },
    "evaluator": {"type": ["object", "null"]},
    "fixture_set_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "source_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": ["string", "null"]},
        "dirty": {"type": ["boolean", "null"]}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_text_included", "response_text_included"],
      "properties": {
        "prompt_text_included": {"const": false},
        "response_text_included": {"const": true}
      }
    },
    "response_count": {"type": "integer", "minimum": 1},
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "media_type", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^[^\\\\]+$"},
          "role": {"enum": ["raw-responses", "evaluation", "recipe-lock", "abom"]},
          "media_type": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/digest"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
